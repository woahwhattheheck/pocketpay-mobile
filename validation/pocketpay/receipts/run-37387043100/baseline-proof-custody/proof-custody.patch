+    @contextmanager
+    def host_proof_scope(self):
+        product_output = self.output
+        self._host_proof_ordinal += 1
+        relative = Path('baseline-host-proofs') / ('closure-' + str(self._host_proof_ordinal).zfill(4))
+        scoped = product_output / relative
+        scoped.parent.mkdir(exist_ok=True)
+        scoped.mkdir()  # Never reuse or overwrite a previous proof directory.
+        previous = getattr(self, 'expo_ordinary_closure', None)
+        closures_before = self.closures
+        self.output = scoped
+        try:
+            yield
+        finally:
+            self.output = product_output
+            proof = getattr(self, 'expo_ordinary_closure', None)
+            if proof is not None and proof is not previous:
+                original = dict(proof)
+                paths = {}
+                for key in ('before', 'after'):
+                    value = Path(proof[key])
+                    if value.is_absolute() or '..' in value.parts:
+                        raise RuntimeError('Host helper proof path is outside its retained directory')
+                    paths[key] = str(relative / value)
+                proof.update(paths, proofDirectory=str(relative))
+                # Shared helper's original closure JSON remains byte-unaltered
+                # in its own folder; this binds latest paths to product ROOT.
+                (scoped / 'proof-directory-binding.json').write_text(json.dumps({
+                    'proofDirectory': str(relative), 'productRootUnchanged': True,
+                    'originalHelperProof': original, 'latestRootRelativeProof': dict(proof),
+                    'observerPreservationChecked': self.closures > closures_before,
+                    'productStatePassed': False,
+                }, indent=2) + '\n')
