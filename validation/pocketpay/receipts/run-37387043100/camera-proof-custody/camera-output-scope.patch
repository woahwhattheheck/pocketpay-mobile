+
+    def capture(self, name, *args, **kwargs):
+        # The actual capture brackets remain owned by the original runner.
+        # Its output root stays unchanged, including unsafe recorder metadata.
+        return self.owner.capture(str(self.relative_directory / name), *args, **kwargs)
 
 
 
