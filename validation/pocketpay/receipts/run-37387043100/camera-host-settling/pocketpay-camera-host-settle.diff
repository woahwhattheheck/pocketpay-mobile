+    def ensure_host_clear(self, tree=None):
+        if self.unsafe_stop:
+            raise collector.UnsafeMedia('Unsafe camera condition blocks host settling')
+        if getattr(self, '_host_settle_active', False):
+            raise RuntimeError('Host-proof paths must use raw guarded dump/capture')
+        if tree is None:
+            tree, _ = self.dump()
+        if not known_developer_sheet(tree):
+            return tree
+        self._host_settle_active = True
+        try:
+            while known_developer_sheet(tree):
+                if intro_sheet(tree):
+                    if not dismiss_observed_intro(self, tree, guarded_action, collector.bounds):
+                        raise RuntimeError('Observed Expo tutorial was not closed')
+                else:
+                    # Exact source-bound native header control, never BACK.
+                    proof = close_ordinary_menu(self)
+                    self.report.setdefault('hostSettling', []).append({
+                        'kind': 'ordinary-menu-closure', 'proof': proof,
+                        'productStatePassed': False})
+                    if proof.get('welcomeObserved') is True and self.host_uri_allowed():
+                        delivery = redeliver_original_uri_once(self, self.original_camera_uri)
+                        self.report['hostSettling'].append({
+                            'kind': 'exact-once-original-uri', 'proof': delivery,
+                            'productStatePassed': False})
+                tree, _ = self.dump()
+            return tree
+        except Exception:
+            # An unknown sheet/activity, missing closure or invalid replay is
+            # not permission to take more guest actions or reset into a pass.
+            self.stop_unsafe()
+            raise
+        finally:
+            self._host_settle_active = False
+
